{
  "version": 1,
  "default_timeout_seconds": 30,
  "default_max_bytes": 4194304,
  "default_cache_ttl_seconds": 86400,
  "max_redirects": 3,
  "max_fields_per_schema": 500,
  "allowed_content_types": [
    "application/json",
    "application/schema+json",
    "application/schema-instance+json",
    "text/json"
  ],
  "tools": {
    "docker": {
      "sources": [
        {
          "url": "https://json.schemastore.org/docker-compose.json",
          "evidence_type": "json_schema",
          "subject_prefix": "docker-compose.yml"
        }
      ]
    },
    "gh": {
      "sources": [
        {
          "url": "https://json.schemastore.org/github-workflow.json",
          "evidence_type": "json_schema",
          "subject_prefix": ".github/workflows/*.yml"
        }
      ]
    },
    "vercel-cli": {
      "sources": [
        {
          "url": "https://json.schemastore.org/vercel.json",
          "evidence_type": "json_schema",
          "subject_prefix": "vercel.json"
        }
      ]
    }
  }
}
