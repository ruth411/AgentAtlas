{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ayiru Curated Tool Sources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "family",
    "version",
    "artifact_id",
    "generated_from",
    "entries"
  ],
  "properties": {
    "family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "const": "v1"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "legacy_seed_script",
            "manual_structured_source"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "destructive",
        "reversible",
        "mutates_remote_state",
        "may_cost_money",
        "may_expose_secrets",
        "risk_level",
        "reasons"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "mutation",
            "destructive",
            "cost",
            "secret_exposure",
            "network",
            "filesystem",
            "compute"
          ]
        },
        "destructive": {
          "type": "boolean"
        },
        "reversible": {
          "type": "boolean"
        },
        "mutates_remote_state": {
          "type": "boolean"
        },
        "may_cost_money": {
          "type": "boolean"
        },
        "may_expose_secrets": {
          "type": "boolean"
        },
        "risk_level": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_artifact_id",
        "migration_method",
        "legacy_seed_script",
        "legacy_tool_id",
        "legacy_title"
      ],
      "properties": {
        "source_artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "migration_method": {
          "type": "string",
          "minLength": 1
        },
        "legacy_seed_script": {
          "type": "string",
          "minLength": 1
        },
        "legacy_tool_id": {
          "type": "string",
          "minLength": 1
        },
        "legacy_title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "kind",
        "title",
        "statement",
        "source_url",
        "source_type",
        "commands",
        "steps",
        "constraints",
        "effect",
        "provenance",
        "confidence"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "recipe",
            "error"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "official_docs",
            "local_docs"
          ]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effect": {
          "$ref": "#/$defs/effect"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
